CREATE TABLE CardEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    deck_id INTEGER NOT NULL,
    front TEXT NOT NULL,
    back TEXT NOT NULL,
    card_type TEXT NOT NULL DEFAULT 'CLASSIC',
    extra_data TEXT NOT NULL DEFAULT '',
    pronunciation_path TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL DEFAULT 0,
    seen_count INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(deck_id) REFERENCES DeckEntity(id) ON DELETE CASCADE
);

selectByDeckId:
SELECT * FROM CardEntity WHERE deck_id = ? ORDER BY created_at ASC;

selectById:
SELECT * FROM CardEntity WHERE id = ?;

insert:
INSERT INTO CardEntity(deck_id, front, back, card_type, extra_data, pronunciation_path, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE CardEntity SET front = ?, back = ?, card_type = ?, extra_data = ?, pronunciation_path = ? WHERE id = ?;

deleteById:
DELETE FROM CardEntity WHERE id = ?;

countByDeckId:
SELECT COUNT(*) FROM CardEntity WHERE deck_id = ?;

incrementSeenCount:
UPDATE CardEntity SET seen_count = seen_count + 1 WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
